includes:
    - vendor/szepeviktor/phpstan-wordpress/extension.neon
parameters:
    level: 6
    paths: [src]
    excludePaths:
        # Legacy 0.4.x tree: stays on disk until P3 deletes it; references removed deps.
        - src/AlpacaBot.php
        - src/Agents.php
        - src/Agents
        - src/Api
        - src/Chat/Post.php
        - src/Chat/Screen.php
        - src/Define.php
        - src/Help.php
        - src/Log
        - src/Utils
    scanFiles: [alpaca-bot.php]
    scanDirectories: [vendor-prefixed]
    bootstrapFiles: [vendor/php-stubs/wordpress-stubs/wordpress-stubs.php]
