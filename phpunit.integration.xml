<?xml version="1.0" encoding="UTF-8"?>
<!--
    The WordPress integration suite: run through `composer test:integration`, which executes it
    inside the harness site's cli container (bin/test-integration.sh) on tools/integration's
    PHPUnit 9, the newest WordPress core's test library supports. That container runs as uid 33
    and cannot write into the bind-mounted checkout, so PHPUnit's result cache lives under /tmp.
-->
<phpunit bootstrap="tests/Integration/bootstrap.php" colors="true" cacheResultFile="/tmp/alpaca-bot-integration/.phpunit.result.cache">
    <testsuites>
        <testsuite name="Integration"><directory>tests/Integration</directory></testsuite>
    </testsuites>
</phpunit>
