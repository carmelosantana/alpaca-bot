{
    "name": "carmelosantana/alpaca-bot",
    "description": "A privately hosted WordPress AI chatbot powered by php-agents.",
    "type": "wordpress-plugin",
    "license": "GPL-2.0-or-later",
    "authors": [
        {
            "name": "Carmelo Santana",
            "email": "me@carmelosantana.com"
        }
    ],
    "require": {
        "php": "^8.4",
        "carmelosantana/php-agents": "~0.15.2",
        "league/commonmark": "^2.10"
    },
    "require-dev": {
        "brain/monkey": "^2.7",
        "dealerdirect/phpcodesniffer-composer-installer": "^1.0",
        "mockery/mockery": "^1.6",
        "pestphp/pest": "^5.1",
        "php-stubs/wordpress-stubs": "^7.1",
        "phpcompatibility/phpcompatibility-wp": "^2.1",
        "phpstan/phpstan": "^2.2",
        "szepeviktor/phpstan-wordpress": "^2.0",
        "wp-coding-standards/wpcs": "^3.1"
    },
    "autoload": {
        "psr-4": {
            "AlpacaBot\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "AlpacaBot\\Tests\\": "tests/"
        }
    },
    "config": {
        "optimize-autoloader": true,
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true,
            "dealerdirect/phpcodesniffer-composer-installer": true
        }
    },
    "extra": {
        "strauss": {
            "target_directory": "vendor-prefixed",
            "namespace_prefix": "AlpacaBot\\Vendor\\",
            "classmap_prefix": "AlpacaBot_Vendor_",
            "constant_prefix": "ALPACA_BOT_VENDOR_",
            "packages": [
                "carmelosantana/php-agents",
                "league/commonmark"
            ],
            "delete_vendor_packages": false,
            "exclude_from_prefix": {
                "file_patterns": []
            }
        }
    },
    "scripts": {
        "prefix": [
            "@composer install --working-dir=tools/strauss --no-interaction",
            "@php bin/strauss"
        ],
        "post-install-cmd": [
            "@prefix"
        ],
        "post-update-cmd": [
            "@prefix"
        ],
        "test": "pest --colors=always",
        "test:integration": "bash bin/test-integration.sh",
        "analyse": "phpstan analyse --memory-limit=1G",
        "lint": "phpcs",
        "lint:fix": "phpcbf",
        "docs:hooks": "@php bin/hooks-doc.php",
        "build": "bash bin/build-zip.sh",
        "check": [
            "@lint",
            "@analyse",
            "@test"
        ]
    }
}
