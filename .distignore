# Everything the release zip must NOT contain. bin/build-zip.sh feeds this to rsync as an
# --exclude-from list, so these are rsync patterns: a leading `/` anchors to the plugin root,
# an unanchored name matches at any depth.
#
# The runtime needs exactly: alpaca-bot.php, readme.txt, LICENSE.md, src/, assets/ and
# vendor-prefixed/. vendor/ is a BUILD-TIME INPUT, not an artifact: alpaca-bot.php registers its
# own PSR-4 loader over src/ and requires only vendor-prefixed/autoload.php, and
# bin/check-bootstrap.php is the guard that Composer's loader is never registered at runtime.

# ---------------------------------------------------------------------------
# Plugin-root paths. Anchored on purpose: an unanchored `composer.json` would strip every
# vendored package's manifest (14 of them today), and an unanchored `resources` would take any
# lowercase resources/ a later strauss run vendors. It would not touch the one vendored tree
# that name is close to, vendor-prefixed/symfony/polyfill-php80/Resources — rsync matches each
# path component as it reads it from disk, and that match is case-sensitive, so `resources` never
# matches `Resources` (probed) — but a spelling is not something to leave the zip's contents
# resting on. Anchoring keeps this list about *this* repo's layout and leaves vendor-prefixed/
# as strauss produced it.
# ---------------------------------------------------------------------------

# VCS and repo metadata
/.git
/.gitattributes
/.gitignore
/.github

# Agent, editor and tool state
/.claude
/.superpowers
/CLAUDE.md
/.editorconfig
/.npmrc

# This file, and the file it replaces
/.distignore
/.zipignore

# Build inputs and outputs that are not the artifact
/vendor
/vendor-wordpress
/node_modules
/dist
/_builds
/_org
/build.mjs
/scripts
/tools
/resources

# wordpress.org listing assets: uploaded to the SVN assets/ dir, never inside the plugin zip
/.wordpress-org

# Dev manifests and lockfiles
/composer.json
/composer.lock
/package.json
/pnpm-lock.yaml
/pnpm-workspace.yaml
/tsconfig.json

# Test and QA config
/.phpunit.cache
/phpcs.xml
/phpcs.xml.dist
/phpstan.neon.dist
/phpunit.xml
/phpunit.integration.xml
/playwright.config.ts
/.wp-env.json
# wp-env reads .wp-env.override.json from the same directory and merges it over .wp-env.json.
# It is the file a developer keeps their personal wp-env settings in, and .github/workflows/
# plugin-check.yml writes one in CI to pin PHP 8.4 -- so it is exactly as unwelcome in the zip as
# .wp-env.json. (In CI the workflow also writes it *after* this script has run, so ordering and
# this line each stop it on their own.)
/.wp-env.override.json
/playwright-report
/test-results

# Developer-facing entry points (readme.txt is the user-facing one and ships)
/bin
/README.md

# ---------------------------------------------------------------------------
# Unanchored: never wanted at any depth, in this repo or in a vendored package.
# ---------------------------------------------------------------------------

# Test suites and test-case base classes. Two of the three vendored Test/ directories are what
# this is for: symfony/http-client-contracts and symfony/service-contracts ship PHPUnit base
# classes there, referencing a PHPUnit no WordPress install has. Their own composer.json names
# "exclude-from-classmap": ["/Test/"], so composer never classmaps them and dropping them leaves
# nothing behind.
#
# symfony/http-client/Test/ is not that. It holds one file, HarFileResponseFactory.php, a shipped
# helper that extends nothing and uses only TransportException, MockResponse and ResponseInterface
# — all shipped — and that package's exclude-from-classmap names "/Tests/", its real test suite,
# not "/Test/". So composer classmaps the class, and excluding the file left
# vendor-prefixed/composer/autoload_classmap.php pointing at a path absent from the zip: a fatal
# waiting for its first caller. vendor-prefixed/ is gitignored and regenerated by
# bin/build-vendor.sh on every build, so editing the generated map would not survive; the
# exclusion is the only durable lever, and 3,351 bytes buys a map whose every entry resolves.
#
# `+ ` lines are rsync include rules and must precede the exclude they override. build-zip.sh's
# rsync is the only consumer of this file (nothing else reads .distignore in this repo).
tests
+ /vendor-prefixed/symfony/http-client/Test/
+ /vendor-prefixed/symfony/http-client/Test/**
Test

# Package documentation (carmelosantana/php-agents ships a docs/ tree)
docs

# Example apps shipped by vendored packages. carmelosantana/php-agents ships
# examples/cli-chat.php and examples/web-summarizer/index.php: standalone entry points with no
# ABSPATH guard that `require dirname(__DIR__, N) . '/vendor/autoload.php'` — a path this zip
# deliberately omits — so reaching one over the web produces only a fatal that leaks the server
# path, and Plugin Check reads both as direct file access. Unanchored rather than naming
# /vendor-prefixed/carmelosantana/php-agents/examples: every vendored examples/ tree is dead
# weight, this keeps the next strauss run from quietly shipping another package's, and unlike
# `resources` — a name packages do give runtime files — nothing a package needs at runtime is
# called `examples`; the only `example*` path anywhere under vendor-prefixed/ is that one, in
# any case.
examples

# IDE helper stubs shipped by league/commonmark and nette/utils
.phpstorm.meta.php

# VCS and editor dotfiles, including the ones inside vendored packages
.git
.gitignore
.gitattributes
.editorconfig

# Never, at any depth
node_modules
